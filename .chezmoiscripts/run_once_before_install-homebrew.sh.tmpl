{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/bash
set -euo pipefail

find_brew() {
    for candidate in \
        "$(command -v brew 2>/dev/null || true)" \
        "/opt/homebrew/bin/brew" \
        "/usr/local/bin/brew" \
        "/home/linuxbrew/.linuxbrew/bin/brew" \
        "$HOME/.linuxbrew/bin/brew"; do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

if BREW_BIN="$(find_brew)"; then
    echo "Homebrew already installed at $BREW_BIN."
else
{{- if eq .chezmoi.os "linux" }}
    if command -v apt-get &>/dev/null; then
        echo "Installing Homebrew prerequisites via apt..."
        sudo apt-get update
        sudo apt-get install -y build-essential procps curl file git
    fi
    # Pre-create /home/linuxbrew/.linuxbrew owned by the current user so
    # Homebrew's installer doesn't need to probe sudo with `sudo -v`/`sudo -l`
    # (which can falsely prompt for a password on NOPASSWD cloud boxes).
    if [ ! -w "/home/linuxbrew/.linuxbrew" ]; then
        sudo mkdir -p /home/linuxbrew/.linuxbrew
        sudo chown -R "$(id -un):$(id -gn)" /home/linuxbrew/.linuxbrew
    fi
    echo "Installing Homebrew..."
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
{{- else }}
    echo "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
{{- end }}
fi
{{- end }}
