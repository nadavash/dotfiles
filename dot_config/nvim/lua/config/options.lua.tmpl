-- Options are automatically loaded before lazy.nvim startup
-- Default options that are always set: https://github.com/LazyVim/LazyVim/blob/main/lua/lazyvim/config/options.lua
-- Add any additional options here
vim.g.lazyvim_rust_diagnostics = "rust-analyzer"

-- Tabs
vim.opt.shiftwidth = 4   -- Size of an indent
vim.opt.tabstop = 4      -- Number of spaces tabs count for
vim.opt.softtabstop = 4  -- Number of spaces tabs count for while editing
vim.opt.expandtab = true -- Use spaces instead of tabs

{{- if eq .chezmoi.hostname "nashkenazi-sovereign-linux-2" }}

vim.opt.clipboard = "unnamedplus"

-- Build a write-only OSC 52 clipboard provider specifically for Herdr
local osc52 = require("vim.ui.clipboard.osc52")
local function internal_paste()
  return { vim.fn.getreg('"', 1, true), vim.fn.getregtype('"') }
end

vim.g.clipboard = {
  name = "osc52-copy-only",
  copy = {
    ["+"] = osc52.copy("+"),
    ["*"] = osc52.copy("*"),
  },
  paste = {
    ["+"] = internal_paste,
    ["*"] = internal_paste,
  },
}

{{- else }}

if vim.env.SSH_TTY or vim.env.SSH_CONNECTION or vim.env.TERM:match("screen") or vim.env.TERM:match("tmux") then
  vim.opt.clipboard = "unnamedplus"
end

{{- end}}
