-- Options are automatically loaded before lazy.nvim startup
-- Default options that are always set: https://github.com/LazyVim/LazyVim/blob/main/lua/lazyvim/config/options.lua
-- Add any additional options here
vim.g.lazyvim_rust_diagnostics = "rust-analyzer"

-- Tabs
vim.opt.shiftwidth = 4   -- Size of an indent
vim.opt.tabstop = 4      -- Number of spaces tabs count for
vim.opt.softtabstop = 4  -- Number of spaces tabs count for while editing
vim.opt.expandtab = true -- Use spaces instead of tabs

-- Disable SmartIndent
vim.opt.smartindent = false

-- Vertical line-length ruler
vim.opt.colorcolumn = "100"
vim.api.nvim_create_autocmd("ColorScheme", {
  callback = function()
    vim.api.nvim_set_hl(0, "ColorColumn", { bg = "#3b4261" })
  end,
})

-- Clipboard: yanks always go out as OSC 52, so the terminal app you are looking at
-- (Ghostty, Rex, or herdr passing it along) puts them on its own machine's clipboard.
-- That works the same locally, over SSH, and through Rex without guessing whether
-- the session is remote. Apple Terminal has no OSC 52 support, so it keeps the default.
-- Paste: on macOS it uses pbpaste (wrong only on a remote Mac); elsewhere it reads
-- Neovim's own register, because OSC 52 reads are slow or blocked in most terminals.
if vim.env.TERM_PROGRAM ~= "Apple_Terminal" then
  vim.opt.clipboard = "unnamedplus"

  local osc52 = require("vim.ui.clipboard.osc52")
  local paste
  if vim.fn.has("mac") == 1 then
    paste = { "pbpaste" }
  else
    paste = function()
      return { vim.fn.getreg('"', 1, true), vim.fn.getregtype('"') }
    end
  end

  vim.g.clipboard = {
    name = "osc52-copy",
    copy = {
      ["+"] = osc52.copy("+"),
      ["*"] = osc52.copy("*"),
    },
    paste = {
      ["+"] = paste,
      ["*"] = paste,
    },
  }
end
