# Common aliases

# av-cli aliases
alias av-sync-full='av sync --rebase-to-trunk --push=yes --prune=yes --ff-trunk'

# Agent helper aliases
alias claude-yolo='claude --dangerously-skip-permissions'

{{- if eq (dig "work" "machine" "" .) "laptop" }}

# Work laptop configuration:

# herdr configuration
alias claude-herdr=HERDR_AGENT='claude declawd --yolo'
alias codex-herdr=HERDR_AGENT='codex declawd --yolo --codex'
alias cursor-herdr=HERDR_AGENT='cursor-agent declawd --yolo --cursor-agent'

{{- end }}

